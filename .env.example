# Anthropic
ANTHROPIC_API_KEY=your_api_key_here

# Database — SQLite for local dev, swap to PostgreSQL for production
DATABASE_URL=sqlite:///./job_radar.db

# Your profile (used as the default user in Phase 1 CLI)
USER_EMAIL=you@example.com
USER_NAME=Your Name

# Job source: wwr (default, free), remotive, indeed (requires Apify)
JOB_SOURCE=wwr

# Search defaults (overridable via --query / --location / --days CLI flags)
INDEED_QUERY=software engineer python backend
INDEED_LOCATION=remote
INDEED_DAYS_OLD=3

# ---- Phase 2 / FastAPI / Web ----

# Clerk — get from https://dashboard.clerk.com -> API Keys
# CLERK_JWKS_URL format: https://<your-clerk-frontend-api>/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# CORS — comma-separated list of allowed origins for the FastAPI backend
# In production: set to your Vercel frontend URL
CORS_ORIGINS=http://localhost:3000
