# Anthropic
ANTHROPIC_API_KEY=your_api_key_here

# Database — SQLite for local dev, swap to PostgreSQL for production
DATABASE_URL=sqlite:///./job_radar.db

# Your profile (used as the default user in Phase 1)
USER_EMAIL=you@example.com
USER_NAME=Your Name

# Job source: wwr (default, free), remotive, indeed (requires Apify)
JOB_SOURCE=wwr

# Search defaults (overridable via --query / --location / --days CLI flags)
INDEED_QUERY=software engineer python backend
INDEED_LOCATION=remote
INDEED_DAYS_OLD=3
